PORT=3001
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu-anon-key
# Clave de servicio (service_role) — bypassa RLS, solo para backend. Obtener en Supabase > Settings > API
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key
N8N_WEBHOOK_URL=https://n8n.suizalabgroup.com/webhook/vidalis-video-upload
N8N_VIRAL_SCORE_URL=https://n8n.suizalabgroup.com/webhook/viral-score
CLOUDINARY_CLOUD_NAME=tu-cloud-name
CLOUDINARY_API_KEY=tu-api-key
CLOUDINARY_API_SECRET=tu-api-secret
CLOUDINARY_UPLOAD_PRESET=tu-upload-preset

# Seguridad
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
# Secreto compartido con n8n para proteger el webhook de callback
WEBHOOK_SECRET=secreto-compartido-con-n8n

# URL del frontend (para redirects OAuth)
FRONTEND_URL=https://vidalis.up.railway.app

# Entorno (development o production)
NODE_ENV=development

# Zernio API
ZERNIO_API_KEY=sk_tu_api_key_de_zernio
ZERNIO_WEBHOOK_SECRET=whsec_tu_secreto_de_webhooks_de_zernio

# Clipper Service (Python FastAPI)
CLIPPER_SERVICE_URL=http://localhost:8080

# Scraper Service (Python FastAPI)
SCRAPER_URL=http://localhost:8080

# ── RabbitMQ (Repurposer) ──
RABBITMQ_URL=amqp://user:pass@host:5672
WORKER_PREFETCH=2

# ── Multi-IA Repurposer Pipeline ──
# Groq Whisper API (https://api.groq.com/openai/v1/audio/transcriptions) — same
# key already used by aiService.js's transcribeWithGroq() for regular video scoring.
GROQ_API_KEY=your-groq-api-key-here

# Whisper (local fallback for transcription — requires `pip install openai-whisper`
# and the `whisper` binary in PATH; not installed in Dockerfile.railway by default)
WHISPER_MODEL_PATH=base

# Video Processing
FFMPEG_PATH=ffmpeg
CLIPS_TEMP_DIR=/tmp/repurposer-clips

# Vidalis Scoring
VIDALIS_API_URL=http://localhost:3001
VIDALIS_API_KEY=your-vidalis-api-key

# Logging
REPURPOSER_LOG_LEVEL=debug
